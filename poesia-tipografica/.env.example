# ─────────────────────────────────────────────────────────────
#  Poesía Tipográfica — configuración del backend (server.py)
#  Copiar a ".env" y completar.
# ─────────────────────────────────────────────────────────────

# ── OpenAI Realtime (transcripción) ──────────────────────────
# La clave NO va acá: se pega en el panel C del show (tecla C) o la pide start_mac.command,
# y se guarda en el Llavero de macOS (Windows: ~/.poesia-tipografica/openai_key).
# Si igual la escribís acá, también funciona.
OPENAI_API_KEY=
# auto = prueba la API Realtime actual (ga) y, si OpenAI la rechaza, la beta histórica
OPENAI_REALTIME_API=auto
OPENAI_REALTIME_GA_URL=wss://api.openai.com/v1/realtime?intent=transcription
# sólo para la API beta:
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime?model=gpt-4o-realtime-preview
# gpt-4o-transcribe / gpt-4o-mini-transcribe emiten deltas incrementales.
# whisper-1 solo emite el evento "completed" (sin deltas).
TRANSCRIPTION_MODEL=gpt-4o-transcribe
TRANSCRIPTION_LANGUAGE=es
# Pista opcional de vocabulario / estilo para el transcriptor
# Pista opcional para el transcriptor (vacía: así nunca se cuela en el texto)
TRANSCRIPTION_PROMPT=
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=350
# Palabras mientras se habla: con habla continua se transcribe cada ~1,8 s en una micro-pausa (0 = esperar la pausa)
OPENAI_COMMIT_S=1.8
VAD_PREFIX_PADDING_MS=300

# ── Audio (micrófono en Windows) ─────────────────────────────
# Índice o parte del nombre del dispositivo (python server.py --list-devices)
# Vacío = dispositivo de entrada por defecto del sistema.
AUDIO_DEVICE=
# Placa multicanal (Focusrite 18i20…): entrada donde está el micrófono (1 = la primera). Se cambia en el panel C.
AUDIO_CHANNEL=1
AUDIO_SAMPLE_RATE=24000
# Bloque de análisis en ms (10 ms => latencia de reactividad ~10-12 ms)
AUDIO_BLOCK_MS=10
# Tamaño de la ventana FFT (muestras). 2048 @ 24 kHz ≈ 85 ms, resolución ≈ 11.7 Hz
AUDIO_FFT_SIZE=2048
# Rango dinámico para normalizar el RMS a 0..1
AUDIO_FLOOR_DB=-58
AUDIO_CEIL_DB=-14
# Cada cuántos ms se envía audio a OpenAI
OPENAI_CHUNK_MS=100

# ── WebSocket local hacia Three.js ───────────────────────────
WS_HOST=localhost
WS_PORT=8765

# ── Director de Arte Semántico (LLM) ─────────────────────────
# ollama | deepseek
LLM_PROVIDER=ollama
# Si Ollama falla, intentar DeepSeek (requiere DEEPSEEK_API_KEY)
LLM_FALLBACK_TO_DEEPSEEK=true
LLM_TIMEOUT_S=25
LLM_TEMPERATURE=0.7

OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_KEEP_ALIVE=30m

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Director de arte con OpenAI (misma clave). Se elige en el panel C.
OPENAI_DIRECTOR_MODEL=gpt-4.1-mini

# ── Logs ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
